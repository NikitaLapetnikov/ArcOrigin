{
  "name": "arcorigin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "contracts:compile": "hardhat compile --config hardhat.config.cjs",
    "contracts:test": "hardhat test --config hardhat.config.cjs",
    "network:verify:arc-mainnet": "node scripts/verify-mainnet-network.cjs",
    "audit:arc-mainnet": "hardhat run scripts/audit-mainnet-state.cjs --network arcMainnet --config hardhat.config.cjs",
    "preflight:arc-mainnet": "DEPLOY_PREFLIGHT_ONLY=true hardhat run scripts/deploy-mainnet.cjs --network arcMainnet --config hardhat.config.cjs",
    "deploy:arc-mainnet": "hardhat run scripts/deploy-mainnet.cjs --network arcMainnet --config hardhat.config.cjs",
    "recover:arc-mainnet-deployment": "hardhat run scripts/recover-mainnet-deployment.cjs --network arcMainnet --config hardhat.config.cjs",
    "verify:arc-mainnet-deployment": "hardhat run scripts/verify-mainnet-deployment.cjs --network arcMainnet --config hardhat.config.cjs",
    "verify:arc-mainnet-bytecode": "hardhat run scripts/verify-mainnet-bytecode.cjs --network arcMainnet --config hardhat.config.cjs",
    "smoke:metadata-upload": "node scripts/smoke-metadata-upload.mjs",
    "test:indexer-resilience": "node --test scripts/test-indexer-resilience.cjs",
    "test:production-health": "node --test scripts/test-production-health.cjs",
    "monitor:production": "node scripts/monitor-production-health.cjs",
    "keeper:buyback": "node scripts/run-buyback-keeper.cjs",
    "test": "npm run contracts:test && npm run test:indexer-resilience && npm run test:production-health"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@safe-global/safe-apps-provider": "^0.18.6",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-table": "^8.21.3",
    "@wagmi/core": "^2.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.6",
    "klinecharts": "^10.0.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.525.0",
    "next": "^15.5.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "redis": "^6.1.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.3.0",
    "viem": "^2.33.0",
    "wagmi": "^2.16.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.4.2",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.2",
    "hardhat": "^2.26.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.9.0"
}
