www.arcorigin.xyz {
	redir https://arcorigin.xyz{uri} permanent
}

arcorigin.xyz {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3100

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/arcorigin.log {
			roll_size 25MiB
			roll_keep 10
		}
	}
}

mainnet.arcorigin.xyz {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3101

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/arcorigin-mainnet.log {
			roll_size 25MiB
			roll_keep 10
		}
	}
}
