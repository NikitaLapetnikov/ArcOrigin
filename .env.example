# ArcOrigin is mainnet-only. Do not configure previous factories as fallbacks.
NEXT_PUBLIC_ARC_NETWORK=mainnet
NEXT_PUBLIC_SITE_URL=https://arcorigin.xyz
NEXT_PUBLIC_MAINNET_APP_URL=https://arcorigin.xyz

# Arc mainnet RPC and explorer. Preserve independently operated fallbacks.
ARC_MAINNET_RPC_URL=https://warp-arc-production.up.railway.app/rpc
ARC_MAINNET_QUOTE_RPC_URLS=https://warp-arc-production.up.railway.app/rpc,https://rpc.arc-scan.org/
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=https://warp-arc-production.up.railway.app/rpc
NEXT_PUBLIC_ARC_MAINNET_RPC_FALLBACK_URLS=https://rpc.arc-scan.org/
NEXT_PUBLIC_ARC_MAINNET_EXPLORER_URL=https://arc-scan.org
NEXT_PUBLIC_ARC_MAINNET_EXPLORER_API_URL=https://api.arc-scan.org/api

# Active Arc mainnet contracts. Fill only after Safe activation and source verification.
NEXT_PUBLIC_MAINNET_FACTORY_ADDRESS=
NEXT_PUBLIC_MAINNET_FACTORY_FROM_BLOCK=
NEXT_PUBLIC_MAINNET_FEE_VAULT_ADDRESS=
NEXT_PUBLIC_MAINNET_CREATOR_REGISTRY_ADDRESS=
NEXT_PUBLIC_MAINNET_LIQUIDITY_LOCKER_ADDRESS=
NEXT_PUBLIC_MAINNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Official Arc Uniswap V3 deployment.
NEXT_PUBLIC_UNISWAP_V3_FACTORY=0xf0db7b58379503491d857db50ac9ece64c653918
NEXT_PUBLIC_UNISWAP_V3_POSITION_MANAGER=0x39654a85a4c05127f5fd6ed22caec077a0fb1377
NEXT_PUBLIC_UNISWAP_V3_QUOTER=0x7dfd4f31be6814d2906bde155c3e1b146eac1468
NEXT_PUBLIC_UNISWAP_V3_ROUTER=0x53bf6b0684ec7ef91e1387da3d1a1769bc5a6f77

# Server-only metadata and cache credentials. Never use NEXT_PUBLIC_ prefixes.
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
REDIS_URL=
DATABASE_URL=
DATABASE_SSL=false

# Dedicated event indexer. Postgres is the canonical event history; Redis is
# the hot status/replay/pub-sub layer used by the SSE endpoint.
INDEXER_CONFIRMATIONS=2
INDEXER_BATCH_SIZE=5000
INDEXER_POLL_INTERVAL_MS=2000
INDEXER_ADDRESS_CHUNK_SIZE=20
INDEXER_REORG_DEPTH=64

# Permissionless automatic-buyback keeper. Use a dedicated, minimally funded
# account that is not a deployer or Safe owner. Store real values only on VPS.
BUYBACK_KEEPER_RPC_URL=
BUYBACK_KEEPER_RPC_FALLBACK_URLS=
BUYBACK_KEEPER_PRIVATE_KEY=
BUYBACK_KEEPER_FACTORY_ADDRESS=

# Health and monitoring.
MAINNET_GOVERNANCE_SAFE=
MAINNET_EXPECT_LAUNCHES_PAUSED=false
PRODUCTION_HEALTH_URL=https://arcorigin.xyz/api/health
INDEXER_MAX_BLOCK_LAG=300
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=slack
MONITOR_FAIL_ON_DEGRADED=false
MONITOR_TIMEOUT_MS=10000

# Deployment only. Never commit real values.
MAINNET_DEPLOYER_PRIVATE_KEY=
MAINNET_EXPECTED_DEPLOYER=
MAINNET_GOVERNANCE_SAFE_OWNERS=
MAINNET_EMERGENCY_GUARDIAN=
MAINNET_RETIRED_FACTORY_ADDRESS=
MAINNET_PROTOCOL_FEE_RECIPIENT=
MAINNET_EXPLORER_URL=https://arc-scan.org
MAINNET_EXPLORER_API_KEY=
