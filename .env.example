# Server-only. Use a dedicated Arc RPC endpoint in production.
ARC_TESTNET_RPC_URL=https://rpc.drpc.testnet.arc.network

# Public Arc Testnet contract addresses.
NEXT_PUBLIC_PROTOCOL_VERSION=5
NEXT_PUBLIC_FACTORY_ADDRESS=0x7a0FB240bcB691555A51DE238aAA3a58c1DB337c
NEXT_PUBLIC_FEE_VAULT_ADDRESS=0x7bfcdA8108Db53B3cCAe02B29C6e5B3905950fB4
NEXT_PUBLIC_CREATOR_REGISTRY_ADDRESS=0x07287313ee649efcF22EAEE4361cd6c512219B61
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Server-only token metadata storage. Never prefix the JWT with NEXT_PUBLIC_.
# Prefer a Pinata V3 key with org:files:write; legacy pinFileToIPFS keys are also supported.
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# Server-only persistent cache and public wallet profiles.
REDIS_URL=

# Deployment scripts only. Never add real values to git.
DEPLOYER_PRIVATE_KEY=
FEE_RECIPIENT=
TREASURY_SAFE=
EMERGENCY_GUARDIAN=
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
