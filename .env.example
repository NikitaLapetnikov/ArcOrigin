# Server-only. Use a dedicated Arc RPC endpoint in production.
ARC_TESTNET_RPC_URL=https://rpc.drpc.testnet.arc.network
NEXT_PUBLIC_ARC_NETWORK=testnet
NEXT_PUBLIC_TESTNET_APP_URL=https://testnet.arcorigin.xyz
NEXT_PUBLIC_MAINNET_APP_URL=https://arcorigin.xyz

# Public Arc Testnet contract addresses.
NEXT_PUBLIC_PROTOCOL_VERSION=6
NEXT_PUBLIC_FACTORY_ADDRESS=0xD342C9d0651Be1138E7cab53C7F38ea02eD61c6d
NEXT_PUBLIC_FACTORY_FROM_BLOCK=54089677
NEXT_PUBLIC_FEE_VAULT_ADDRESS=0x41FDE27BBBE46DfDF310235Ac7D3F72F1F041bd5
NEXT_PUBLIC_CREATOR_REGISTRY_ADDRESS=0x2CEB61D011cD15988DA50a03B57B3bA72F01D0f0
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Server-only token metadata storage. Never prefix the JWT with NEXT_PUBLIC_.
# Prefer a Pinata V3 key with org:files:write; legacy pinFileToIPFS keys are also supported.
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# Server-only persistent cache and public wallet profiles.
REDIS_URL=

# Deployment scripts only. Never add real values to git.
DEPLOYER_PRIVATE_KEY=
FEE_RECIPIENT=
TREASURY_SAFE=
EMERGENCY_GUARDIAN=
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Arc mainnet public network configuration. Deployment should still use a
# dedicated reviewed RPC when one is available; the probe script verifies that
# any configured endpoint is chain 5042 before it is used.
ARC_MAINNET_RPC_URL=https://rpc.blockdaemon.mainnet.arc.io
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=https://rpc.blockdaemon.mainnet.arc.io
NEXT_PUBLIC_ARC_MAINNET_EXPLORER_URL=https://arc-mainnet.cloud.blockscout.com
# Optional Etherscan-compatible log API. Leave empty to use canonical RPC logs directly.
NEXT_PUBLIC_ARC_MAINNET_EXPLORER_API_URL=https://arc-mainnet.cloud.blockscout.com/api
NEXT_PUBLIC_ARC_TESTNET_EXPLORER_API_URL=https://testnet.arcscan.app/api
NEXT_PUBLIC_MAINNET_FACTORY_ADDRESS=
NEXT_PUBLIC_MAINNET_FACTORY_FROM_BLOCK=
NEXT_PUBLIC_MAINNET_FEE_VAULT_ADDRESS=
NEXT_PUBLIC_MAINNET_CREATOR_REGISTRY_ADDRESS=
NEXT_PUBLIC_MAINNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000
MAINNET_CURVE_DEPLOYER_ADDRESS=
NEXT_PUBLIC_UNISWAP_V3_FACTORY=0xf0db7b58379503491d857db50ac9ece64c653918
NEXT_PUBLIC_UNISWAP_V3_POSITION_MANAGER=0x39654a85a4c05127f5fd6ed22caec077a0fb1377
NEXT_PUBLIC_UNISWAP_V3_QUOTER=0x7dfd4f31be6814d2906bde155c3e1b146eac1468
NEXT_PUBLIC_UNISWAP_V3_ROUTER=0x53bf6b0684ec7ef91e1387da3d1a1769bc5a6f77

# Arc mainnet deployment only. Never reuse the testnet deployer or commit values.
MAINNET_DEPLOYER_PRIVATE_KEY=
MAINNET_EXPECTED_DEPLOYER=
MAINNET_GOVERNANCE_SAFE=
# Exact reviewed Safe owners, comma-separated. Readiness requires exactly 3.
MAINNET_GOVERNANCE_SAFE_OWNERS=
MAINNET_TREASURY_SAFE=
MAINNET_EMERGENCY_GUARDIAN=
MAINNET_EXPLORER_URL=https://arc-mainnet.cloud.blockscout.com
# Optional when the configured Blockscout instance requires an API key.
MAINNET_EXPLORER_API_KEY=

# Optional post-graduation Uniswap migration. These Arc addresses come from the
# official Uniswap SDK. Migration stays paused until runtime hashes are pinned,
# the ArcOrigin adapter stack is audited, and governance executes activation.
UNISWAP_V3_FACTORY=0xf0db7b58379503491d857db50ac9ece64c653918
UNISWAP_V3_POSITION_MANAGER=0x39654a85a4c05127f5fd6ed22caec077a0fb1377
UNISWAP_V3_QUOTER=0x7dfd4f31be6814d2906bde155c3e1b146eac1468
UNISWAP_V3_SWAP_ROUTER=0x53bf6b0684ec7ef91e1387da3d1a1769bc5a6f77
UNISWAP_MIGRATION_VERSION=v3
UNISWAP_V3_FACTORY_CODEHASH=0x621c4819f7b62d7ddb153206bc30950bcc3f5cc9d24c45661f8c2f31dcbd166d
UNISWAP_V3_POSITION_MANAGER_CODEHASH=0xcad0552151ba7675afe512ebe77fcc6eed68a0cb65775d31e38d44823e6796a0
UNISWAP_V3_QUOTER_CODEHASH=0xf222999269407743c526ee7c9d0c9b4fabec26773d48fd6fd257c5ebca976ea7
UNISWAP_V3_SWAP_ROUTER_CODEHASH=0xc53680bc70e67f7e8818a0e1302e9b70a4460493bc6dd6db056575b17cb3af25
ARCORIGIN_MIGRATION_ADAPTER=
ARCORIGIN_LIQUIDITY_LOCKER=
ARCORIGIN_MIGRATION_VERIFIER=
ARCORIGIN_MIGRATION_ADAPTER_CODEHASH=
ARCORIGIN_LIQUIDITY_LOCKER_CODEHASH=
ARCORIGIN_MIGRATION_VERIFIER_CODEHASH=

# Explicit human release gates consumed by readiness:arc-mainnet:v6.
MAINNET_EXPECT_LAUNCHES_PAUSED=true
MAINNET_SOURCE_VERIFICATION_CONFIRMED=false
MAINNET_INDEPENDENT_AUDIT_APPROVED=false
MAINNET_INDEXER_REORG_TESTED=false
MAINNET_MONITORING_TESTED=false
